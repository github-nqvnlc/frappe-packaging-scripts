# ---------------------------------------------------------
# FILE MẪU: CẤU HÌNH THÔNG TIN DỰ ÁN CHO SCRIPT SETUP SMRS
# (Lưu file này thành .env hoặc config.env để script đọc)
# ---------------------------------------------------------

# 1. THÔNG TIN VỀ CUSTOM APP
# Link Git để clone app (nên dùng HTTPS kèm token nếu là repo private)
CUSTOM_APP_GIT_URL="https://github.com/your-username/your_custom_app.git"
CUSTOM_APP_BRANCH="main"
# Tên thư mục/tên app để sử dụng trong lệnh "bench install-app"
CUSTOM_APP_NAME="your_custom_app" 

# 2. PHIÊN BẢN FRAPPE / ERPNEXT
# Các branch phổ biến: version-14, version-15, develop
FRAPPE_BRANCH="version-15"

# 3. THÔNG TIN DOCKER IMAGE
# Tên tag cho image mà script sẽ tự động build
CUSTOM_IMAGE_TAG="smrs-custom-image:latest"

# 4. CẤU HÌNH DOMAIN & TRAEFIK (SSL)
# Email nhận thông báo gia hạn SSL từ Let's Encrypt
LETSENCRYPT_EMAIL="admin@yourdomain.com"
# Tên miền chính của hệ thống (Ví dụ: erp.congty.com)
SITE_DOMAIN="yourdomain.com"
# Tên project Docker Compose (để cô lập môi trường nếu có nhiều site)
PROJECT_NAME="smrs-project"

# 5. THÔNG TIN BẢO MẬT (MẬT KHẨU)
# Mật khẩu root của MariaDB (đảm bảo tính bảo mật cao)
DB_ROOT_PASSWORD="ChangeMe_Secure_DB_Password_123!"
# Mật khẩu cho tài khoản 'Administrator' của Frappe/ERPNext
FRAPPE_ADMIN_PASSWORD="ChangeMe_Secure_Admin_Password_123!"
